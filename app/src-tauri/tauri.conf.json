{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sora Fan Patch",
  "version": "0.1.0",
  "identifier": "org.fanpatch.sora012",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sora for Dissidia 012 — fan patch",
        "width": 800,
        "height": 720,
        "minWidth": 560,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "dmg",
      "app",
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Fan patch installer",
    "copyright": "Made by Mat. GPL-3.0-or-later. Unofficial fan-made project. Not affiliated with the makers or publishers of the game.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../LICENSE": "LICENSE.txt"
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
